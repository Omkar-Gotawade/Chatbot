# ============================================================
# Hardware Assistant – Environment Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# Your Dialogflow ES project ID (found in GCP Console)
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id

# Absolute path to your Google Cloud service-account JSON key file
# Example (Windows): C:\keys\my-service-account.json
# Example (Linux/Mac): /home/user/keys/my-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=./keys/service-account.json

# Language code for Dialogflow (default: en)
DIALOGFLOW_LANGUAGE_CODE=en

# Port the local Express server will listen on (default: 3000)
PORT=3000
